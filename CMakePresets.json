{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${hostSystemName}-${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -march=native",
        "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG -march=native",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "default",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows",
      "inherits": "default",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "PKG_CONFIG_PATH": "C:/Apps/msys64/ucrt64/lib/pkgconfig;C:/Apps/msys64/usr/local/lib/pkgconfig",
        "PATH": "C:/Apps/msys64/ucrt64/bin;C:/Apps/msys64/usr/local/bin;C:/Apps/local/bin;C:/Program Files/Git/usr/bin;$penv{PATH}"
      }
    },
    {
      "name": "win-debug",
      "inherits": "windows",
      "displayName": "Windows Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-release",
      "inherits": "windows",
      "displayName": "Windows Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
 ]
}